# IMKON Digital API — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env

ENVIRONMENT=development
DEBUG=true

# PostgreSQL (async — asyncpg drayveri)
DATABASE_URL=postgresql+asyncpg://imkon:imkon@postgres:5432/imkon

# Redis
REDIS_URL=redis://redis:6379/0

# S3-mos storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=imkon-media

# CORS — vergul bilan
CORS_ORIGINS=http://localhost:3000
