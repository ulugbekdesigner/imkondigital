# Production sirlari — docker-compose.prod.yml shu qiymatlarni talab qiladi.
# Nusxa oling: cp .env.prod.example .env  (keyin haqiqiy qiymatlar bilan to'ldiring)
# Bu fayl GIT'GA COMMIT QILINADI (faqat namuna) — .env esa hech qachon commit qilinmaydi.
# To'liq qadamlar: docs/deploy.md

DOMAIN=imkondigital.uz
SECRET_KEY=
POSTGRES_PASSWORD=
