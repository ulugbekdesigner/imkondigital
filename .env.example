# Docker Compose host portlari — standart qiymatlar quyida.
# Agar bu portlar band bo'lsa (masalan boshqa loyiha ishlab tursa),
# .env fayl yaratib qiymatlarni o'zgartiring: cp .env.example .env
#
# Ichki servislararo aloqa (api↔postgres va h.k.) o'zgarmaydi — faqat host portlari.

POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
